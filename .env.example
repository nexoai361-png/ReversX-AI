# OPENROUTER_API_KEY: Your OpenRouter API key (sk-or-v1-...).
# Can also be entered directly in Settings > BYOK in the app UI.
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# OPENROUTER_MODEL: Default model to use (e.g. google/gemini-2.5-flash, meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL="google/gemini-2.5-flash"

# PORT: Local/Termux server port (default 3000)
PORT=3000

# Optional fallback or alternative
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
